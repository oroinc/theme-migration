{
    "name": "oro/theme-migration",
    "description": "Oro Theme Migration Bundle",
    "type": "symfony-bundle",
    "keywords": ["Oro", "Theme"],
    "homepage": "https://github.com/oroinc/theme-migration",
    "license": "MIT",
    "authors": [
        {
            "name": "Oro, Inc",
            "homepage": "https://oroinc.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Oro\\Bundle\\ThemeMigrationBundle\\": "src/Oro/Bundle/ThemeMigrationBundle"
        },
        "exclude-from-classmap": ["**/Tests/"]
    },
    "require": {
        "oro/platform": "~6.0.0"
    },
    "repositories": {
        "oro": {
            "type": "composer",
            "url": "https://packagist.oroinc.com"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "6.0-dev"
        }
    }
}
